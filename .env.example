# Copy to .shim.env and fill in. Never commit the filled-in file.
WORKER_URL=https://opencode-delta.<account>.workers.dev/<PATH_SECRET>
SHIM_TOKEN=<same value as the Worker's SHIM_TOKEN secret>

# Optional tuning
# STORE_MIN=4096
# BASE_MIN=4096
# CACHE_MB=256
# ALLOW_HOSTS=opencode.ai
# SHIM_TRACE=1
# FALLBACK_DIRECT=0
# FALLBACK_GZIP=auto
